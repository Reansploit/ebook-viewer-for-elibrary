{
  "name": "ebook-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "git submodule update --init vendor/reo-engine && npm install",
    "update-engine": "git submodule update --remote vendor/reo-engine && git add vendor/reo-engine",
    "predev": "git submodule update --init vendor/reo-engine",
    "prebuild": "git submodule update --init vendor/reo-engine",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "quill": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
