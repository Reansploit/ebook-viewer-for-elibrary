{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebook Viewer",
  "version": "0.1.0",
  "identifier": "com.wbs.ebookviewer",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "https://viewer.elibrary.local"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ebook Viewer",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Reansploit/ebook-viewer-for-elibrary/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyMTY5MTcwQkFDRDkzNjEKUldSaGs4MjZjSkVXSXFGZDVScGF3Z3lGM245dGJNT0hsK3BLTnV1Um1GTFRuWmF1YnFsbnhPOXcK"
    }
  }
}
